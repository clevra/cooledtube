{
  "manifest_version": 2,
  "name": "YouTube Clickbait Filter",
  "version": "0.1.0",
  "description": "Filters and de-emphasizes clickbait videos on YouTube.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "https://*.youtube.com/*"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "YouTube Clickbait Filter",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["clickbait_detector.js", "content_script.js"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
